<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.DekkerDing.ecommerce.repository.mybatis.PaymentMybatisMapper">

    <!-- 支付结果映射 / Payment Result Map -->
    <resultMap id="paymentResultMap" type="io.github.DekkerDing.ecommerce.domain.payment.Payment">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="transactionId" column="transaction_id"/>
        <result property="channel" column="channel"/>
        <result property="amount" column="amount"/>
        <result property="status" column="status"/>
        <result property="callbackData" column="callback_data"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

</mapper>
